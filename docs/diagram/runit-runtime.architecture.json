  "cards": [
    {
      "dot": "cyan",
      "title": "Execution model",
      "items": [
        "Execution is the root aggregate; every artifact belongs to exactly one execution",
        "Six immutable artifacts: Context, Activity, Measurement, Observation, Occurrence, Snapshot",
        "Terminal states: SUCCEEDED · FAILED · CANCELLED · TIMED_OUT"
      ]
    },
    {
      "dot": "emerald",
      "title": "Publication pipeline",
      "items": [
        "Stages: validate → enrich → classify → redact → sample → route → publish",
        "Redact secrets before external export; fail-open default with fallback reporting",
        "Recursion guard prevents self-instrumentation loops"
      ]
    },
    {
      "dot": "violet",
      "title": "Ports (vendor-neutral effects)",
      "items": [
        "MonotonicClock, IdentifierGenerator, Serializer",
        "ContextStorage, ArtifactPublisher, SnapshotStore, SnapshotSigner",
        "Adapters implement ports; domain/app depend only on the port, never the adapter (ADR-006/010)"
      ]
    },
    {
      "dot": "amber",
      "title": "Context & propagation",
      "items": [
        "Context is immutable; changes produce a new context",
        "Secrets are never exported (deny-by-default classification)",
        "Per-call / per-Fiber / per-coroutine storage; restored in finally"
      ]
    },
    {
      "dot": "rose",
      "title": "Security & trust",
      "items": [
        "Domain is the trusted center; external adapters sit at the edge",
        "Cardinality bounds and payload size limits on artifacts",
        "Original business exception has priority over adapter failures"
      ]
    }
  ]
}
