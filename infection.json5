{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.33.3/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "threads": "max",
    "timeout": 60,
    "testFramework": "codeception",
    // Dogfood tooling tests (`@group dogfood`) are excluded from mutation runs: they
    // validate the dev-tooling harness, not library mutants, and their teardown path is
    // nondeterministic under Infection's process model (see REVIEW §3 P1-2 / plan T1.1).
    "testFrameworkExtraArgs": "Unit --skip-group dogfood",
    "mutators": {
        "@default": true
    },
    // MSI floors are the ratchet gate (REVIEW R-4 / plan Phase 4 T4.2). They start at 0
    // so the first CI run of `.github/workflows/mutation.yml` can capture the baseline
    // without failing. Once the full-profile MSI is recorded in docs/ROADMAP.md M13.5,
    // replace these with (baseline - ~5 points). Infection fails the job only when a
    // floor is breached; timed-out mutants are excluded from MSI by default, so timeout
    // noise never fails the job. (Local runs confirm covering-test selection works.)
    "minMsi": 0,
    "minCoveredMsi": 0,
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection.summary.json"
    }
}
