{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.33.3/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "threads": "max",
    "timeout": 60,
    "testFramework": "codeception",
    // Dogfood tooling tests (`@group dogfood`) are excluded from mutation runs: they
    // validate the dev-tooling harness, not library mutants, and their teardown path is
    // nondeterministic under Infection's process model (see REVIEW §3 P1-2 / plan T1.1).
    "testFrameworkExtraArgs": "Unit --skip-group dogfood",
    "mutators": {
        "@default": true
    },
    // MSI floors are intentionally provisional (0) until CI captures the full-profile
    // baseline. In this environment Infection runs the full Unit suite per mutant
    // (the Codeception adapter's covering-test selection does not narrow under the
    // local pcov setup), so every mutant times out and a clean MSI cannot be measured
    // locally. Once CI reports the `infection.json5` baseline, set these to
    // (baseline - small epsilon). See REVIEW §3 P1-2 / plan T1.2.
    "minMsi": 0,
    "minCoveredMsi": 0,
    "logs": {
        "text": "var/infection.log",
        "summary": "var/infection.summary.json"
    }
}
