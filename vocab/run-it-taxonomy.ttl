# =============================================================================
# Standard context key concepts
# =============================================================================

runit-tax:ctx-environment
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Environment"@en ;
    skos:notation       "environment" ;
    skos:definition     "The runtime environment name (e.g. 'production', 'staging', 'development')."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-tenant-id
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Tenant ID"@en ;
    skos:notation       "tenant.id" ;
    skos:definition     "The tenant or organisation identifier for multi-tenant operations."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-workspace-id
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Workspace ID"@en ;
    skos:notation       "workspace.id" ;
    skos:definition     "The workspace or project identifier."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-locale
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Locale"@en ;
    skos:notation       "locale" ;
    skos:definition     "The locale or language setting for the execution (e.g. 'en-US', 'de-DE')."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-principal-id
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Principal ID"@en ;
    skos:notation       "principal.id" ;
    skos:definition     "The authenticated principal or user identifier."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-principal-type
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Principal type"@en ;
    skos:notation       "principal.type" ;
    skos:definition     "The type of the authenticated principal (e.g. 'user', 'service-account', 'system')."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-correlation-id
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Correlation ID"@en ;
    skos:notation       "correlation.id" ;
    skos:definition     "A correlation identifier used to trace related executions across service boundaries."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-trace-id
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Trace ID"@en ;
    skos:notation       "trace.id" ;
    skos:definition     "A distributed trace identifier for integration with tracing systems (e.g. OpenTelemetry)."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-feature-flags
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Feature flags"@en ;
    skos:notation       "feature_flags" ;
    skos:definition     "Snapshot of active feature flags at the time of execution."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-configuration-snapshot-id
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Configuration snapshot ID"@en ;
    skos:notation       "configuration.snapshot_id" ;
    skos:definition     "Identifier of the configuration snapshot version used by this execution."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-service-name
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Service name"@en ;
    skos:notation       "service.name" ;
    skos:definition     "The name of the service or application performing the execution."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-service-version
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Service version"@en ;
    skos:notation       "service.version" ;
    skos:definition     "The version of the service or application performing the execution."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:ctx-deployment-environment
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ContextKeys ;
    skos:topConceptOf   runit-tax:ContextKeys ;
    skos:prefLabel      "Deployment environment"@en ;
    skos:notation       "deployment.environment" ;
    skos:definition     "The deployment environment identifier (e.g. 'production-us-east-1')."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

# =============================================================================
# Occurrence type concepts
# =============================================================================

runit-tax:occ-configuration-loaded
    a                   skos:Concept ;
    skos:inScheme       runit-tax:OccurrenceTypes ;
    skos:topConceptOf   runit-tax:OccurrenceTypes ;
    skos:prefLabel      "Configuration loaded"@en ;
    skos:notation       "itpack.configuration.loaded.v1" ;
    skos:definition     "Published when configuration has been fully loaded and resolved."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:occ-schema-validated
    a                   skos:Concept ;
    skos:inScheme       runit-tax:OccurrenceTypes ;
    skos:topConceptOf   runit-tax:OccurrenceTypes ;
    skos:prefLabel      "Schema validated"@en ;
    skos:notation       "itpack.schema.validated.v1" ;
    skos:definition     "Published when a schema validation check has completed."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:occ-snapshot-created
    a                   skos:Concept ;
    skos:inScheme       runit-tax:OccurrenceTypes ;
    skos:topConceptOf   runit-tax:OccurrenceTypes ;
    skos:prefLabel      "Snapshot created"@en ;
    skos:notation       "itpack.snapshot.created.v1" ;
    skos:definition     "Published when a snapshot has been created and stored."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:occ-pipeline-completed
    a                   skos:Concept ;
    skos:inScheme       runit-tax:OccurrenceTypes ;
    skos:topConceptOf   runit-tax:OccurrenceTypes ;
    skos:prefLabel      "Pipeline completed"@en ;
    skos:notation       "itpack.pipeline.completed.v1" ;
    skos:definition     "Published when a pipeline has completed execution."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:occ-workflow-completed
    a                   skos:Concept ;
    skos:inScheme       runit-tax:OccurrenceTypes ;
    skos:topConceptOf   runit-tax:OccurrenceTypes ;
    skos:prefLabel      "Workflow completed"@en ;
    skos:notation       "itpack.workflow.completed.v1" ;
    skos:definition     "Published when a workflow has completed execution."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.
