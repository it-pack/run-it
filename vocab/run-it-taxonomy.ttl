@prefix :               <https://w3id.org/itpack/runit/taxonomy#> .
@prefix runit-tax:      <https://w3id.org/itpack/runit/taxonomy#> .
@prefix runit:          <https://w3id.org/itpack/runit#> .
@prefix rdf:            <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:           <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:            <http://www.w3.org/2002/07/owl#> .
@prefix xsd:            <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:           <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms:        <http://purl.org/dc/terms/> .
@prefix vann:           <http://purl.org/vocab/vann/> .

# =============================================================================
# Taxonomy header
# =============================================================================

<https://w3id.org/itpack/runit/taxonomy>
    a                   owl:Ontology ;
    dcterms:title       "RunIt Execution Taxonomy"@en ;
    dcterms:description "SKOS taxonomy of extensible execution kinds, activity kinds, context keys, occurrence types, and other controlled vocabularies for the RunIt execution model. Consumers may extend these concept schemes with their own concepts."@en ;
    dcterms:creator     "ItPack contributors"@en ;
    dcterms:license     <https://opensource.org/licenses/MIT> ;
    dcterms:date        "2026-07-30"^^xsd:date ;
    vann:preferredNamespacePrefix  "runit-tax" ;
    vann:preferredNamespaceUri     "https://w3id.org/itpack/runit/taxonomy#" ;
    owl:imports         <https://w3id.org/itpack/runit> ;
    rdfs:seeAlso        <https://w3id.org/itpack/runit> ;
.

# =============================================================================
# Concept schemes
# =============================================================================

runit-tax:ExecutionKinds
    a                   skos:ConceptScheme ;
    rdfs:label          "Execution Kind Taxonomy"@en ;
    rdfs:comment        "Taxonomy of execution kinds. Execution kinds classify the type of runtime operation an execution represents. Extensible: consumers may define additional kinds."@en ;
    skos:hasTopConcept  runit-tax:http-request ,
                        runit-tax:cli-command ,
                        runit-tax:queue-job ,
                        runit-tax:configuration-resolution ,
                        runit-tax:workflow ,
                        runit-tax:worker-iteration ,
                        runit-tax:scheduled-task ,
                        runit-tax:build ,
                        runit-tax:migration ,
                        runit-tax:event-processing ,
                        runit-tax:llm-pipeline ,
                        runit-tax:custom-operation ;
.

runit-tax:ActivityKinds
    a                   skos:ConceptScheme ;
    rdfs:label          "Activity Kind Taxonomy"@en ;
    rdfs:comment        "Taxonomy of activity kinds. Activities describe bounded units of work inside an execution. Extensible."@en ;
    skos:hasTopConcept  runit-tax:discover-files ,
                        runit-tax:read-resources ,
                        runit-tax:load-yaml ,
                        runit-tax:merge-documents ,
                        runit-tax:validate-schema ,
                        runit-tax:resolve-variables ,
                        runit-tax:download-secrets ,
                        runit-tax:build-graph ,
                        runit-tax:freeze-snapshot ;
.

runit-tax:ContextKeys
    a                   skos:ConceptScheme ;
    rdfs:label          "Standard Context Key Vocabulary"@en ;
    rdfs:comment        "Recommended standard context keys for execution context entries. These are conventions; consumers may use additional keys."@en ;
    skos:hasTopConcept  runit-tax:ctx-environment ,
                        runit-tax:ctx-tenant-id ,
                        runit-tax:ctx-workspace-id ,
                        runit-tax:ctx-locale ,
                        runit-tax:ctx-principal-id ,
                        runit-tax:ctx-principal-type ,
                        runit-tax:ctx-correlation-id ,
                        runit-tax:ctx-trace-id ,
                        runit-tax:ctx-feature-flags ,
                        runit-tax:ctx-configuration-snapshot-id ,
                        runit-tax:ctx-service-name ,
                        runit-tax:ctx-service-version ,
                        runit-tax:ctx-deployment-environment ;
.

runit-tax:OccurrenceTypes
    a                   skos:ConceptScheme ;
    rdfs:label          "Occurrence Type Vocabulary"@en ;
    rdfs:comment        "Recommended stable occurrence type names. Occurrence types follow the pattern <organization>.<domain>.<fact>.<version>. Extensible."@en ;
    skos:hasTopConcept  runit-tax:occ-configuration-loaded ,
                        runit-tax:occ-schema-validated ,
                        runit-tax:occ-snapshot-created ,
                        runit-tax:occ-pipeline-completed ,
                        runit-tax:occ-workflow-completed ;
.

# =============================================================================
# Execution kind concepts
# =============================================================================

runit-tax:http-request
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "HTTP request"@en ;
    skos:notation       "http.request" ;
    skos:definition     "An execution representing an incoming or outgoing HTTP request."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:cli-command
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "CLI command"@en ;
    skos:notation       "cli.command" ;
    skos:definition     "An execution representing a CLI command invocation."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:queue-job
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Queue job"@en ;
    skos:notation       "queue.job" ;
    skos:definition     "An execution representing a single queue job processing cycle."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:configuration-resolution
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Configuration resolution"@en ;
    skos:notation       "configuration.resolution" ;
    skos:definition     "An execution representing a configuration resolution pipeline (discover, load, merge, validate, resolve, freeze)."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:workflow
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Workflow"@en ;
    skos:notation       "workflow" ;
    skos:definition     "An execution representing a multi-step workflow or process."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:worker-iteration
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Worker iteration"@en ;
    skos:notation       "worker.iteration" ;
    skos:definition     "An execution representing one iteration of a persistent background worker."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:scheduled-task
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Scheduled task"@en ;
    skos:notation       "scheduled.task" ;
    skos:definition     "An execution representing a scheduled or cron task."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:build
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Build"@en ;
    skos:notation       "build" ;
    skos:definition     "An execution representing a build or compilation process."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:migration
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Migration"@en ;
    skos:notation       "migration" ;
    skos:definition     "An execution representing a database or schema migration."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:event-processing
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Event processing"@en ;
    skos:notation       "event.processing" ;
    skos:definition     "An execution representing an event processing cycle."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:llm-pipeline
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "LLM pipeline"@en ;
    skos:notation       "llm.pipeline" ;
    skos:definition     "An execution representing an LLM inference or pipeline operation."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:custom-operation
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ExecutionKinds ;
    skos:topConceptOf   runit-tax:ExecutionKinds ;
    skos:prefLabel      "Custom operation"@en ;
    skos:notation       "custom" ;
    skos:definition     "A custom execution kind not covered by the standard taxonomy. Use this for application-specific execution types."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

# =============================================================================
# Activity kind concepts
# =============================================================================

runit-tax:discover-files
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ActivityKinds ;
