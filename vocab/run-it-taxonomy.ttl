.

runit-tax:build-graph
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ActivityKinds ;
    skos:topConceptOf   runit-tax:ActivityKinds ;
    skos:prefLabel      "Build graph"@en ;
    skos:notation       "build.graph" ;
    skos:definition     "Activity that constructs a dependency or resolution graph."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:freeze-snapshot
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ActivityKinds ;
    skos:topConceptOf   runit-tax:ActivityKinds ;
    skos:prefLabel      "Freeze snapshot"@en ;
    skos:notation       "freeze.snapshot" ;
    skos:definition     "Activity that creates an immutable snapshot of resolved state."@en ;
