    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:validate-schema
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ActivityKinds ;
    skos:topConceptOf   runit-tax:ActivityKinds ;
    skos:prefLabel      "Validate schema"@en ;
    skos:notation       "validate.schema" ;
    skos:definition     "Activity that validates data against a schema definition."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:resolve-variables
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ActivityKinds ;
    skos:topConceptOf   runit-tax:ActivityKinds ;
    skos:prefLabel      "Resolve variables"@en ;
    skos:notation       "resolve.variables" ;
    skos:definition     "Activity that resolves variable references, placeholders, or interpolation patterns."@en ;
    rdfs:isDefinedBy    <https://w3id.org/itpack/runit/taxonomy> ;
.

runit-tax:download-secrets
    a                   skos:Concept ;
    skos:inScheme       runit-tax:ActivityKinds ;
    skos:topConceptOf   runit-tax:ActivityKinds ;
    skos:prefLabel      "Download secrets"@en ;
    skos:notation       "download.secrets" ;
