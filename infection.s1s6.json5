{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.33.3/resources/schema.json",
    "source": {
        "directories": [
            "src/Domain/Context",
            "src/Application/Lifecycle",
            "src/Adapter/Common",
            "src/Domain/Snapshot",
            "src/SDK/Attribute",
            "src/Application/Publication"
        ]
    },
    "threads": "max",
    "timeout": 60,
    "testFramework": "codeception",
    // Dogfood tooling tests (`@group dogfood`) are excluded from mutation runs: they
    // validate the dev-tooling harness, not library mutants, and their teardown path is
    // nondeterministic under Infection's process model (see REVIEW §3 P1-2 / plan T1.1).
    "testFrameworkExtraArgs": "Unit --skip-group dogfood",
    "mutators": {
        "@default": true
    },
    // Critical-branching profile (state transitions, failure policies, context
    // restoration, redaction, sampling, validators, adapter mappings per AGENTS.md).
    // MSI floors are intentionally provisional (0) until CI captures the baseline; in
    // this environment Infection times out per mutant (full Unit suite per mutant under
    // the Codeception adapter), so a clean MSI cannot be measured locally. Set these to
    // (baseline - small epsilon) once CI reports it. See REVIEW §3 P1-2 / plan T1.2.
    "minMsi": 0,
    "minCoveredMsi": 0,
    "logs": {
        "text": "var/infection.s1s6.log",
        "summary": "var/infection.s1s6.summary.json"
    }
}
