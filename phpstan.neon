parameters:
    tmpDir: var/cache/phpstan
    level: max
    paths:
        - ./src
        - ./tests/Acceptance
        - ./tests/Functional
        - ./tests/Integration
        - ./tests/Support/Fixture
        - ./tests/Unit
    parallel:
        maximumNumberOfProcesses: 1
    reportUnmatchedIgnoredErrors: false

    ignoreErrors: []
