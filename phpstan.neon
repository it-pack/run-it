includes:
    - tools/phpstan/runit-rules/extension.neon

parameters:
    tmpDir: var/cache/phpstan
    level: max
    paths:
        - ./src
        - ./tests/Acceptance
        - ./tests/Conformance
        - ./tests/Functional
        - ./tests/Integration
        - ./tests/Support/Fixture
        - ./tests/Unit
        - ./tools/phpstan/runit-rules/src
    parallel:
        maximumNumberOfProcesses: 1
    reportUnmatchedIgnoredErrors: false

    ignoreErrors: []
