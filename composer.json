{
    "name": "it-pack/run-it",
    "description": "The execution model and runtime backbone for the ItPack ecosystem.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ItPack\\RunIt\\": "src/",
            "ItPack\\RunIt\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "tidal",
            "email": "timomichna@yahoo.de"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "just-bases/php-obs-base": "^1.0",
        "codeception/module-phpbrowser": "*",
        "codeception/module-asserts": "*"
    },
    "require-dev": {
        "just-bases/php-unit-test-base": "^1.0",
        "just-bases/php-qa-base": "^1.0",
        "just-bases/php-obs-dev-base": "^0.1.0",
        "symfony/http-client": "^8.1",
        "nyholm/psr7": "^1.8"
    },
    "suggest": {
        "psr/clock": "PSR-20 clock integration",
        "psr/log": "PSR-3 observation and logger integration",
        "psr/event-dispatcher": "PSR-14 occurrence integration",
        "psr/http-message": "HTTP context propagation",
        "psr/http-server-handler": "PSR-15 execution middleware",
        "open-telemetry/api": "OpenTelemetry mapping",
        "open-telemetry/sdk": "OpenTelemetry SDK/export support",
        "cloudevents/sdk-php": "CloudEvents occurrence mapping",
        "ext-openswoole": "OpenSwoole coroutine execution adapter",
        "ext-swoole": "Swoole coroutine execution adapter"
    },
    "scripts": {
        "test:unit": "vendor/bin/codecept run Unit",
        "test:functional": "vendor/bin/codecept run Unit",
        "test:integration": "vendor/bin/codecept run Unit",
        "coverage": "vendor/bin/codecept run Unit --coverage --coverage-xml --coverage-html",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs:fix": "vendor/bin/php-cs-fixer fix",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "dantleech/what-changed": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}